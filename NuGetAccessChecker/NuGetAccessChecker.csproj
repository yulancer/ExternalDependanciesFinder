<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>NuGetAccessChecker</RootNamespace>
        <LangVersion>10.0</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NuGet.Protocol" Version="4.3.1" />
        <PackageReference Include="NuGet.Frameworks" Version="4.3.1" />
        <PackageReference Include="NuGet.Configuration" Version="4.3.1" />
        <PackageReference Include="NuGet.Versioning" Version="4.3.1" />
    </ItemGroup>

</Project>
