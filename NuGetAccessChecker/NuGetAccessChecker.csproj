<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Пакеты NuGet.Client для работы с источниками и загрузкой .nupkg -->
        <PackageReference Include="NuGet.Protocol" Version="4.3.1" />
        <PackageReference Include="NuGet.Frameworks" Version="4.3.1" />
        <PackageReference Include="NuGet.Configuration" Version="4.3.1" />
        <PackageReference Include="NuGet.Versioning" Version="4.3.1" />
    </ItemGroup>

</Project>
